#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse-gesture.h>   // 追加(2026-10-01): GESTURE_UP などの名前

#define MOUSE 4
#define SCROLL 5
#define NUM 6

// 追加(2026-10-01): マウスジェスチャーの中身（S+H長押し中＝レイヤー9で有効）
&zip_mouse_gesture {
    always-active;          // レイヤー9に入っている間は常に判定する
    enable-eager-mode;      // 動きが決まった瞬間に実行する
    stroke-size = <200>;    // 1方向と判定する移動量（大きくすると大きく動かす必要あり）

    gs_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(LEFT)>;      // 戻る
    };
    gs_forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(RIGHT)>;     // 進む
    };
    gs_top {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(HOME)>;      // ページ先頭
    };
    gs_bottom {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(END)>;       // ページ末尾
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    // 追加(2026-10-01): 2組目のジェスチャー（Y+P長押し中＝レイヤー10で有効）
    // 左手側のビルドでは使わないので、参照されない時は省く(omit-if-no-ref)
    /omit-if-no-ref/ zip_gesture_vd: zip_gesture_vd {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        stroke-size = <200>;

        vd_prev {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LG(LEFT))>;    // 前の仮想デスクトップ
        };
        vd_next {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(LG(RIGHT))>;   // 次の仮想デスクトップ
        };
        win_max {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(UP)>;          // 最大化
        };
        win_restore {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(DOWN)>;        // 復元（もう一度で最小化）
        };
    };

    // 追加(2026-10-01): 3組目のジェスチャー（J+B長押し中＝レイヤー11で有効）
    /omit-if-no-ref/ zip_gesture_tab: zip_gesture_tab {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        enable-eager-mode;
        stroke-size = <200>;

        tab_prev {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(PG_UP)>;       // 前のタブ
        };
        tab_next {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(PG_DN)>;       // 次のタブ
        };
        tab_reopen {
            pattern = <GESTURE_UP>;
            bindings = <&kp LC(LS(T))>;       // 閉じたタブを開き直す
        };
        tab_close {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LC(W)>;           // タブを閉じる
        };
    };

    combos {
        compatible = "zmk,combos";

        // 追加: 左手 23+24（大西配列のX+C）の同時押しで Tab
        tab_left {
            bindings = <&kp TAB>;
            key-positions = <23 24>;
            timeout-ms = <40>;               // 変更(2026-10-01): 50→40（全コンボの判定時間をそろえる）               // 50ミリ秒以内の同時押しで発動
            require-prior-idle-ms = <150>;   // 直前150ミリ秒以内に他のキーを打っていたら発動しない（タイピング中の誤爆防止）
        };

        // 追加: 右手 31+32（大西配列のM+J）の同時押しで Tab。左と鏡写しの位置
        tab_right {
            bindings = <&kp TAB>;
            key-positions = <31 32>;
            timeout-ms = <40>;               // 変更(2026-10-01): 50→40（J+Bと共有するJで固まる不具合を避ける）
            require-prior-idle-ms = <150>;
        };

        // 追加(2026-10-01): 右手 20+21（大西配列のS+H）
        //   タップ＝Alt+Tab、長押し＝レイヤー9（ボールでジェスチャー）
        //   AML中(4)にも使えるよう 0 4 7 で有効
        gesture_sh {
            bindings = <&lt 9 LA(TAB)>;
            key-positions = <20 21>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };

        // 追加(2026-10-01): 右手 8+9（大西配列のY+P）
        //   タップ＝タスクビュー(Win+Tab)、長押し＝レイヤー10（仮想デスクトップ・ウィンドウのジェスチャー）
        gesture_yp {
            bindings = <&lt 10 LG(TAB)>;
            key-positions = <8 9>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };

        // 追加(2026-10-01): 右手 32+33（大西配列のJ+B）
        //   タップ＝新しいタブ(Ctrl+T)、長押し＝レイヤー11（タブ操作のジェスチャー）
        gesture_jb {
            bindings = <&lt 11 LC(T)>;
            key-positions = <32 33>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };

        // 追加(2026-10-01): 閉じる系コンボ（左右対称・ホームポジション）
        //   3キー＝タブを閉じる、＋小指＝ウィンドウを閉じる、＋親指＝タスクマネージャー
        // 左 I+A+O → タブを閉じる(Ctrl+W)
        close_tab_l {
            bindings = <&kp LC(W)>;
            key-positions = <11 12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };
        // 左 E+I+A+O → ウィンドウを閉じる(Alt+F4)
        close_win_l {
            bindings = <&kp LA(F4)>;
            key-positions = <10 11 12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };
        // 左 E+I+A+O+スペース → タスクマネージャー(Ctrl+Shift+Esc)
        taskmgr_l {
            bindings = <&kp LC(LS(ESCAPE))>;
            key-positions = <10 11 12 13 38>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };
        // 右 T+N+S → タブを閉じる(Ctrl+W)
        close_tab_r {
            bindings = <&kp LC(W)>;
            key-positions = <18 19 20>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };
        // 右 T+N+S+H → ウィンドウを閉じる(Alt+F4)
        close_win_r {
            bindings = <&kp LA(F4)>;
            key-positions = <18 19 20 21>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };
        // 右 T+N+S+H+エンター → タスクマネージャー(Ctrl+Shift+Esc)
        taskmgr_r {
            bindings = <&kp LC(LS(ESCAPE))>;
            key-positions = <18 19 20 21 41>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 4 7>;
        };

        // ---- 以下 2026-09-30 追加（ホーム段・上段コンボ）----
        // layers = <0 7>：通常時(0)とノートモード時(7)だけ有効。
        //   AML(レイヤー4)中はMB1〜MB5と重なるので無効にする。
        // timeout-ms は既存より短い40ms（ホーム段の連続打鍵での誤爆対策）

        // 左手 12+13（大西配列のA+O）→ 英数
        eisu_ao {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };

        // 右手 18+19（大西配列のT+N）→ かな
        kana_tn {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };

        // 左手 11+12（大西配列のI+A）→ Tab
        tab_ia {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };

        // 右手 19+20（大西配列のN+S）→ Tab
        tab_ns {
            bindings = <&kp TAB>;
            key-positions = <19 20>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };

        // 左手 1+2（大西配列のL+U）→ Esc
        esc_lu {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };

        // 右手 7+8（大西配列のR+Y）→ Esc
        esc_ry {
            bindings = <&kp ESCAPE>;
            key-positions = <7 8>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <0 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 追加: 長押しでレイヤー移動、「一度タップしてすぐ長押し」でキーの連続入力（BSのリピート用）
        lt_rep: lt_rep {
            compatible = "zmk,behavior-hold-tap";
            display-name = "LT Repeat";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                   &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G        &mkp RCLK                  &kp UP_ARROW    &kp H        &kp J  &kp K      &lt 4 L  &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B        &mkp LCLK                  &kp DOWN_ARROW  &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &lt 1 SPACE  &lt 3 INTERNATIONAL_5      &kp BACKSPACE   &lt 2 ENTER                             &kp DEL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &trans  &trans  &trans  &trans   &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans         &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL      &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans         &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&lt 5 SPACE  &lt 4 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt 4 SPACE  &lt 5 SPACE
&trans       &trans       &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans       &trans       &trans           &trans             &trans     &trans         &trans  &trans                                                      &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };
        // 追加: レイヤー7 ノートモード（中身は空。オンの間だけカーソルが遅くなる）
        laptop_mode {
            display-name = "LAPTOP";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 追加: レイヤー8 スクロール（従来のレイヤー5と同じ中身。ノートモード中でもスクロールが効く）
        scroll_top {
            display-name = "SCROLL2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 追加(2026-10-01): レイヤー9 ジェスチャー（S+H長押し中だけ有効。キーは全部下のレイヤーのまま）
        gesture_sh_layer {
            display-name = "GESTURE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 追加(2026-10-01): レイヤー10 ジェスチャー2（Y+P長押し中だけ有効。キーは全部下のレイヤーのまま）
        gesture_yp_layer {
            display-name = "GESTURE2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 追加(2026-10-01): レイヤー11 ジェスチャー3（J+B長押し中だけ有効。キーは全部下のレイヤーのまま）
        gesture_jb_layer {
            display-name = "GESTURE3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

    };
};
